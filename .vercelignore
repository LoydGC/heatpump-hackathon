# Files Vercel does NOT upload when deploying. The live site is index.html
# plus any folder it loads from (e.g. ui/, assets/, data/processed/, results/).
# If the page needs a file listed here, remove that line (see docs/local-and-deploy.md).

# Raw data and archives
*.zip
*.xlsx
*.xls
data/raw/
data/scripts/

# Model / analysis code (not served), except the one file the site loads.
# Gitignore-style re-include: a directory itself can't be re-included once excluded,
# so exclude its contents (model/*), re-include model/results/, exclude its contents,
# then re-include frontend_data.json. NOT YET TESTED ON VERCEL: after the next deploy
# confirm /model/results/frontend_data.json returns 200 (see D-013).
model/*
!model/results/
model/results/*
!model/results/frontend_data.json
comsol/
notebooks/
tests/
src/
scripts/
*.py
*.ipynb
*.mph

# Repo docs and tooling
docs/
tools/
.claude/
*.md
run-local-*
update-activity-*
.gitignore
.vercelignore

# Secrets (also gitignored)
.env
.env.*
*.pem
*.key
credentials*.json
